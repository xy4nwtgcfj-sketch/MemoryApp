# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.

# Claude API für die Strukturierung (ohne Key: manuelle Erfassung)
ANTHROPIC_API_KEY=
# Modell und Aufwand. effort=low hält die Erfassung schnell.
LV_CLAUDE_MODEL=claude-opus-5-5
LV_CLAUDE_EFFORT=low

# Voyage AI für echte semantische Suche (ohne Key: lokaler, nur unscharfer Fallback)
VOYAGE_API_KEY=
LV_VOYAGE_MODEL=voyage-3.5
# auto | voyage | lokal
LV_EMBEDDINGS=auto

# Datenbankpfad
LV_DB_PATH=data/lessons.db

# Optionaler zweiter Schutz zusätzlich zu Tailscale. Leer = kein Token.
LV_TOKEN=
