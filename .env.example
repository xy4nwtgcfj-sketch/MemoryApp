# Kopieren nach .env und ausfüllen. .env wird nicht eingecheckt.

# --- Claude (Cloud) -----------------------------------------------------------
# Strukturierung per Claude. Leer lassen = keine Cloud-KI.
ANTHROPIC_API_KEY=
LV_CLAUDE_MODEL=claude-opus-5-5
LV_CLAUDE_EFFORT=low
# Denkaufwand für Briefing-Pläne (Fachwissen + Erfahrung), low | medium | high
LV_BRIEFING_EFFORT=medium

# --- Lokal über Ollama --------------------------------------------------------
LV_OLLAMA_URL=http://127.0.0.1:11434
# Modell für die Hintergrund-Strukturierung. Nach dem Messskript ggf. ändern. Leer = aus.
LV_OLLAMA_MODEL=qwen2.5:7b
# Embedding-Modell für die semantische Suche
LV_OLLAMA_EMBED_MODEL=bge-m3

# --- Embeddings ---------------------------------------------------------------
# ollama | voyage | lokal | auto
#   ollama: semantisch und lokal (empfohlen auf dem Home-PC)
#   voyage: semantisch über Voyage AI (Cloud, braucht VOYAGE_API_KEY)
#   lokal:  ohne Modell, nur unscharfe Wortteil-Suche
#   auto:   bleibt beim bisher genutzten Anbieter; sonst Ollama, wenn erreichbar; sonst Voyage; sonst lokal
LV_EMBEDDINGS=ollama
VOYAGE_API_KEY=
LV_VOYAGE_MODEL=voyage-3.5

# --- Fotos --------------------------------------------------------------------
# Pfad zu tesseract.exe, nur nötig, wenn nicht unter C:\Program Files\Tesseract-OCR installiert
LV_TESSERACT_CMD=
# Ordner für Fotos (Standard: neben der Datenbank in data/bilder)
LV_BILDER_PATH=

# --- Sonstiges ----------------------------------------------------------------
LV_DB_PATH=data/lessons.db
# Zugangstoken. Leer = wird beim ersten Start erzeugt und in data/zugangstoken.txt abgelegt.
LV_TOKEN=
# Erlaubte Host-Namen (Schutz gegen DNS-Rebinding). *.ts.net deckt "tailscale serve" ab.
LV_HOSTS=127.0.0.1,localhost,*.ts.net
# Zielordner der täglichen Sicherung, am besten außerhalb des PCs (OneDrive, NAS)
LV_BACKUP_ZIEL=backups
